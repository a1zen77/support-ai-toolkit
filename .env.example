# Copy this file to .env and adjust as needed.
# All values below are safe defaults — nothing here is a secret.
# This project uses a LOCAL LLM (Ollama). No external API keys are required
# to run Tasks 1-3. See the design note ("Data Sensitivity") for why.

# --- Ollama (local LLM) ---
# Host where the Ollama server is running. Default assumes `ollama serve`
# running on the same machine.
OLLAMA_HOST=http://localhost:11434

# Model used for classification, summarisation, and draft generation.
# Recommended: qwen2.5:7b-instruct or llama3.1:8b (fits comfortably in 16GB RAM).
# Swap to llama3.2:3b for a faster/lighter run — see design note for the
# latency-vs-quality trade-off this affects.
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional: separate model used only as the LLM-as-judge in the eval harness
# (Task 3). Defaults to OLLAMA_MODEL if unset.
OLLAMA_JUDGE_MODEL=qwen2.5:7b-instruct

# --- Embeddings (local, for KB retrieval — no external API calls) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Data paths (defaults match the repo layout; override only if you move files) ---
TICKETS_PATH=data/tickets.json
ACCOUNTS_PATH=data/accounts.json
KB_DIR=knowledge_base

# --- Determinism (Task 2 requires deterministic output for the same input) ---
LLM_TEMPERATURE=0.0
LLM_SEED=42

# --- "As of" date used to compute "last 90 days" windows for Task 2.
# The dataset's ticket history ends 2026-05-22, so this defaults to that date
# rather than wall-clock "today" (see README for why). Format: YYYY-MM-DD.
AS_OF_DATE=2026-05-22

# --- API server (Task 1 FastAPI endpoint) ---
API_HOST=0.0.0.0
API_PORT=8000

LOG_LEVEL=INFO